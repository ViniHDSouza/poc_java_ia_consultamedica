# =============================================================================
# OPENROUTER - executa o modelo de IA
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Metadados opcionais recomendados pelo OpenRouter.
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=poc_java_ia_consultamedica

# O projeto original da aula usa 0.7. Mantemos o mesmo valor por fidelidade.
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TIMEOUT_SECONDS=60


# =============================================================================
# LANGSMITH - observabilidade/tracing
# =============================================================================
# Chave usada para enviar traces ao LangSmith.
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Liga/desliga o tracing. Se false, a aplicação funciona sem enviar traces.
LANGSMITH_TRACING=false

# Projeto que aparecerá no LangSmith.
LANGSMITH_PROJECT=poc-java-ia-consultamedica

# Endpoint SaaS padrão. Para self-hosted, informe o endpoint correspondente.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Se true, os spans de chamadas ao modelo incluem prompt/saída.
# IMPORTANTE: esta POC usa somente dados fictícios.
LANGSMITH_INCLUDE_LLM_PAYLOADS=true


# =============================================================================
# COMPATIBILIDADE COM AS VARIÁVEIS DO PROJETO ORIGINAL JAVASCRIPT
# =============================================================================
# O application.yml também aceita estes nomes antigos como fallback:
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=03-medical-appointment
#
# Na versão Java, os nomes LANGSMITH_* acima são os recomendados.
